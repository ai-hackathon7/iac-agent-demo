#!/usr/bin/env node
import 'source-map-support/register';
import * as cdk from 'aws-cdk-lib';
import { DevMyprojectStack } from '../lib/stack';

const app = new cdk.App();

new DevMyprojectStack(app, 'DevMyprojectStack', {
  env: {
    account: process.env.CDK_DEFAULT_ACCOUNT,
    region:  process.env.CDK_DEFAULT_REGION,
  },
  description: 'dev-myproject: VPC, SSH security group, and ECS Fargate bastion service',
});